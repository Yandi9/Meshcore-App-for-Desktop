<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             xmlns:conv="using:MC1.Windows.Converters"
             x:Class="MC1.Windows.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,14,20,16">
    <!-- Recent -->
    <StackPanel IsVisible="{Binding HasRecent}" Margin="0,0,0,8">
      <TextBlock Classes="section" Text="{l:T 'RECENT'}" Margin="2,0,0,4" />
      <ItemsControl ItemsSource="{Binding Recent}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecentConnectionRow">
            <Grid ColumnDefinitions="*,Auto">
              <Button Classes="row" Command="{Binding $parent[UserControl].((vm:ConnectViewModel)DataContext).ConnectRecentCommand}" CommandParameter="{Binding}"
                      IsEnabled="{Binding !$parent[UserControl].((vm:ConnectViewModel)DataContext).IsConnecting}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}" Foreground="{DynamicResource App.Accent}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Classes="caption" />
                  </StackPanel>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Remove'}" Command="{Binding $parent[UserControl].((vm:ConnectViewModel)DataContext).RemoveRecentCommand}" CommandParameter="{Binding}">
                <PathIcon Classes="small" Data="{StaticResource Icon.Close}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TabControl Grid.Row="1" Classes="pages" SelectedIndex="{Binding TabIndex}" IsEnabled="{Binding !IsConnecting}">
      <TabItem Header="Bluetooth">
        <DockPanel Margin="0,10,0,0">
          <StackPanel DockPanel.Dock="Top" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding BleStatus}" Classes="hint" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <ProgressBar IsIndeterminate="True" Width="50" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
                <Button Content="{l:T 'Scan'}" Command="{Binding ScanCommand}" IsVisible="{Binding !IsScanning}" IsEnabled="{Binding BluetoothSupported}" />
                <Button Content="{l:T 'Stop'}" Command="{Binding StopScanCommand}" IsVisible="{Binding IsScanning}" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,120,*,Auto" Margin="0,8,0,0">
            <TextBlock Text="{l:T 'Pairing PIN'}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding BluetoothPin}" Watermark="123456" MaxLength="6" />
            <Button Grid.Column="3" Classes="accent" Content="{l:T 'Connect'}" Command="{Binding ConnectBluetoothCommand}" />
          </Grid>
          <ListBox Classes="plain" ItemsSource="{Binding BleDevices}" SelectedItem="{Binding SelectedBle}" Margin="0,8,0,0" MinHeight="120">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BleDeviceRow">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Data="{StaticResource Icon.Bluetooth}" Foreground="{DynamicResource App.Accent}" Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AddressText}" Classes="caption mono" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Signal}" Classes="caption" HorizontalAlignment="Right" />
                    <TextBlock Text="{l:T 'Paired'}" Classes="tertiary" IsVisible="{Binding IsPaired}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="USB">
        <StackPanel Margin="0,12,0,0" Spacing="8">
          <TextBlock Classes="hint" Text="{l:T 'Connect the radio with a USB data cable. It must run MeshCore companion USB (serial) firmware.'}" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" HorizontalAlignment="Stretch" PlaceholderText="{l:T 'No serial ports found'}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SerialPortRow">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="small" Data="{StaticResource Icon.Usb}" />
                    <TextBlock Text="{Binding Title}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="{l:T 'Refresh'}" Margin="8,0,0,0" Command="{Binding RefreshPortsCommand}" />
          </Grid>
          <Button Classes="accent" Content="{l:T 'Connect'}" HorizontalAlignment="Right" Command="{Binding ConnectSerialCommand}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="WiFi">
        <StackPanel Margin="0,12,0,0" Spacing="8">
          <TextBlock Classes="hint" Text="{l:T 'For radios running MeshCore companion WiFi firmware on the same network as this PC.'}" />
          <Grid ColumnDefinitions="*,Auto,100">
            <TextBox Text="{Binding Host}" Watermark="{l:T 'IP address or host name'}" />
            <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="6,0" />
            <TextBox Grid.Column="2" Text="{Binding Port}" Watermark="5000" />
          </Grid>
          <Button Classes="accent" Content="{l:T 'Connect'}" HorizontalAlignment="Right" Command="{Binding ConnectTcpCommand}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="{l:T 'Demo'}">
        <StackPanel Margin="0,12,0,0" Spacing="8">
          <TextBlock Classes="hint" Text="{l:T 'Try the app without hardware. A simulated radio with a few contacts, channels and a room server generates realistic traffic.'}" />
          <Button Classes="accent" Content="{l:T 'Start demo radio'}" HorizontalAlignment="Right" Command="{Binding ConnectDemoCommand}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConnecting}">
        <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Classes="link" Content="{l:T 'Cancel'}" Command="{Binding CancelConnectCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button Content="{l:T 'Close'}" HorizontalAlignment="Right" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
