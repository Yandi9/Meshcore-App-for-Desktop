<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             xmlns:conv="using:MC1.Windows.Converters"
             x:Class="MC1.Windows.Views.RoomInfoView"
             x:DataType="vm:RoomInfoViewModel">
  <StackPanel Margin="20,16" Spacing="6">
    <TextBlock Text="{Binding Name}" Classes="h2" />
    <TextBlock Text="{Binding Status}" Classes="secondary" />
    <SelectableTextBlock Text="{Binding Key}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
    <TextBlock Classes="section" Text="{l:T 'NOTIFICATIONS'}" />
    <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding NotificationLevel}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Classes="section" Text="{l:T 'ACCOUNT'}" />
    <WrapPanel>
      <Button Content="{l:T 'Manage room server…'}" Command="{Binding ManageCommand}" IsVisible="{Binding IsAdmin}" Margin="0,0,8,8" />
      <Button Content="{l:T 'Forget saved password'}" Command="{Binding ForgetPasswordCommand}" IsVisible="{Binding HasSavedPassword}" Margin="0,0,8,8" />
      <Button Content="{l:T 'Sign out'}" Command="{Binding SignOutCommand}" Margin="0,0,8,8" />
      <Button Classes="danger" Content="{l:T 'Leave room…'}" Command="{Binding LeaveCommand}" Margin="0,0,8,8" />
    </WrapPanel>
  </StackPanel>
</UserControl>
