<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             xmlns:conv="using:MC1.Windows.Converters"
             x:Class="MC1.Windows.Views.ShellView"
             x:DataType="vm:MainWindowViewModel">
  <!-- The app's content: navigation rail, the current page, status bar and toasts. Rebuilt when the language changes. -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="Auto,*">

    <!-- Navigation rail (can be minimised to a slim icon strip) -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="rail" Classes.collapsed="{Binding NavCollapsed}" Background="{DynamicResource App.Sidebar}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,6" Spacing="6">
          <Image Classes="raillogo" Source="/Assets/AppIcon.png" HorizontalAlignment="Center" />
          <Button Classes="icon" HorizontalAlignment="Center" Command="{Binding ToggleNavCommand}" ToolTip.Tip="{Binding NavToggleTip}">
            <PathIcon Classes="small" Data="{Binding NavToggleIcon, Converter={x:Static conv:IconConverter.Instance}}" Foreground="{DynamicResource App.TextSecondary}" />
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="icon" HorizontalAlignment="Center" Margin="0,0,0,14"
                Command="{Binding ConnectOrDisconnectCommand}"
                ToolTip.Tip="{Binding StatusText}">
          <Grid>
            <PathIcon Classes="large" Data="{Binding StatusIcon, Converter={x:Static conv:IconConverter.Instance}}"
                      Foreground="{DynamicResource App.TextSecondary}" />
            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{DynamicResource App.Success}" IsVisible="{Binding IsConnected}" />
          </Grid>
        </Button>
        <ListBox Classes="navrail" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Grid ToolTip.Tip="{Binding Label}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                  <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}" Width="22" Height="22" HorizontalAlignment="Center" />
                  <TextBlock Classes="navlabel" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="badge navbadge" Background="{DynamicResource App.Danger}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        IsVisible="{Binding Badge, Converter={x:Static conv:PositiveConverter.Instance}}">
                  <TextBlock Text="{Binding Badge}" />
                </Border>
                <Ellipse Classes="navalert" Width="9" Height="9" Fill="{DynamicResource App.Warning}" HorizontalAlignment="Right" VerticalAlignment="Top"
                         IsVisible="{Binding Alert}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page content -->
    <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- Status bar -->
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="0,1,0,0" Padding="12,5">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Classes="small" Data="{Binding StatusIcon, Converter={x:Static conv:IconConverter.Instance}}" Foreground="{DynamicResource App.TextSecondary}" />
          <TextBlock Classes="caption" Text="{Binding RadioName}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="·" />
          <TextBlock Classes="caption" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>
        <ProgressBar Grid.Column="1" Margin="16,0" Height="4" MinWidth="80" MaxWidth="260" HorizontalAlignment="Left" VerticalAlignment="Center"
                     IsVisible="{Binding IsSyncing}" IsIndeterminate="{Binding SyncIndeterminate}" Value="{Binding SyncProgress}" />
        <Button Grid.Column="2" Classes="link" Margin="0,0,16,0" IsVisible="{Binding ContactsFull}" Command="{Binding OpenRadioPageCommand}"
                ToolTip.Tip="{l:T 'The radio\'s contact table is full. Remove contacts or enable \'overwrite oldest\' in auto-add settings.'}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Classes="small" Data="{StaticResource Icon.AlertOutline}" Foreground="{DynamicResource App.Warning}" />
            <TextBlock Classes="caption" Text="{l:T 'Contacts full'}" Foreground="{DynamicResource App.Warning}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="0,0,16,0" IsVisible="{Binding HasBattery}" VerticalAlignment="Center">
          <PathIcon Classes="small" Data="{Binding BatteryIcon, Converter={x:Static conv:IconConverter.Instance}}" Foreground="{DynamicResource App.TextSecondary}" />
          <TextBlock Classes="caption" Text="{Binding BatteryText}" />
        </StackPanel>
        <Button Grid.Column="4" Content="{Binding ConnectButtonText}" Command="{Binding ConnectOrDisconnectCommand}" Padding="12,3" FontSize="12" />
      </Grid>
    </Border>

    <!-- Toasts -->
    <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,20,16" Width="340" ZIndex="10">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastItem">
          <Border Classes="card" Margin="0,6,0,0" Padding="14,10" BoxShadow="0 6 20 0 #33000000" Cursor="Hand"
                  PointerPressed="Toast_OnPointerPressed">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Body}" Classes="secondary" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="13" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
