<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             xmlns:m="using:MC1.Core.Models"
             xmlns:conv="using:MC1.Windows.Converters"
             x:Class="MC1.Windows.Views.TracePathView"
             x:DataType="vm:TracePathViewModel">
  <Grid ColumnDefinitions="300,*">
    <!-- Repeater picker -->
    <Border Classes="pane">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,6" Spacing="6">
          <TextBlock Classes="h3" Text="{l:T 'Repeaters'}" />
          <TextBlock Classes="hint" Text="{l:T 'Click a repeater to add it as the next hop.'}" />
          <TextBox Watermark="{l:T 'Search'}" Text="{Binding RepeaterSearch}" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Margin="14,6,14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="{l:T 'Add hop by hash code…'}" Command="{Binding AddManualHopCommand}" />
        <ListBox Classes="plain" ItemsSource="{Binding Repeaters}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:ContactRecord">
              <Button Classes="row" Padding="4,2" HorizontalContentAlignment="Stretch" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).AddHopCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortKey}" Classes="caption mono" />
                  </StackPanel>
                  <PathIcon Grid.Column="1" Classes="small" Data="{StaticResource Icon.PlusCircle}" Foreground="{DynamicResource App.Accent}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="24,18" Spacing="10" MaxWidth="820" HorizontalAlignment="Stretch">
        <TextBlock Classes="pagetitle" Text="{l:T 'Trace Path'}" />
        <TextBlock Classes="hint" Text="{l:T 'Sends a trace packet along a fixed route and reports the SNR each repeater measured. Use it to check how well links in your mesh work.'}" />

        <Border Classes="group" Padding="14,10">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h3" Text="{l:T 'Path'}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Classes="link" Content="{l:T 'Copy'}" Command="{Binding CopyPathCommand}" Margin="0,0,10,0" />
                <Button Classes="link" Content="{l:T 'Show on map'}" Command="{Binding ShowOnMapCommand}" Margin="0,0,10,0" />
                <Button Classes="link" Content="{l:T 'Clear'}" Command="{Binding ClearHopsCommand}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Hops}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TraceHopEntry">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <Border Classes="chip" Margin="0,0,10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding HashText}" Classes="mono" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button Classes="icon" ToolTip.Tip="{l:T 'Move up'}" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).MoveHopUpCommand}" CommandParameter="{Binding}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.ChevronUp}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="{l:T 'Move down'}" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).MoveHopDownCommand}" CommandParameter="{Binding}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.ChevronDown}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="{l:T 'Remove'}" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).RemoveHopCommand}" CommandParameter="{Binding}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.Close}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PathText}" Classes="caption mono" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DistanceText}" Classes="caption" IsVisible="{Binding DistanceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel>
              <CheckBox Content="{l:T 'Round trip (return the same way)'}" IsChecked="{Binding RoundTrip}" Margin="0,0,18,0" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0" IsEnabled="{Binding CanChangeHashMode}">
                <TextBlock Text="{l:T 'Hash size'}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding HashModes}" SelectedIndex="{Binding HashMode}" MinWidth="100" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{l:T 'Runs'}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding BatchOptions}" SelectedItem="{Binding BatchCount}" MinWidth="70" />
              </StackPanel>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Play}" Foreground="White" />
                  <TextBlock Text="{l:T 'Run trace'}" Foreground="White" />
                </StackPanel>
              </Button>
              <Button Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
              <Button Content="{l:T 'Save path…'}" Command="{Binding SavePathCommand}" />
              <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="group" Padding="14,10" IsVisible="{Binding HasResult}">
          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="{l:T 'Result'}" />
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TraceResultRow">
                  <Grid ColumnDefinitions="28,*,Auto,160" Margin="0,4">
                    <TextBlock Text="{Binding Index}" Classes="caption" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding HashText}" Classes="caption mono" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SnrText}" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"
                               Foreground="{Binding Color, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                    <Border Grid.Column="3" Height="8" CornerRadius="4" Background="{DynamicResource App.Chip}" VerticalAlignment="Center">
                      <Border HorizontalAlignment="Left" CornerRadius="4" Width="{Binding Quality, Converter={x:Static conv:ScaleConverter.Instance}, ConverterParameter=160}"
                              Background="{Binding Color, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding BatchSummary}" Classes="caption" IsVisible="{Binding BatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding BatchRuns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TraceBatchRun">
                  <TextBlock Classes="caption" Text="{Binding Summary, StringFormat='• {0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="{l:T 'SAVED PATHS'}" />
        <Border Classes="group" Padding="8,6">
          <StackPanel>
            <TextBlock Classes="hint" Margin="8,6" Text="{l:T 'No saved paths yet.'}" IsVisible="{Binding !SavedPaths.Count}" />
            <ItemsControl ItemsSource="{Binding SavedPaths}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:TracePathRecord">
                  <Grid ColumnDefinitions="*,Auto" Margin="6,3">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                      <Button Content="{l:T 'Load'}" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).LoadPathCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T 'Run'}" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).RunSavedCommand}" CommandParameter="{Binding}" />
                      <Button Classes="icon" ToolTip.Tip="{l:T 'Delete'}" Command="{Binding $parent[UserControl].((vm:TracePathViewModel)DataContext).DeleteSavedCommand}" CommandParameter="{Binding}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.DeleteOutline}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
